# Banco de dados PostgreSQL
# Local (docker compose up -d):
DATABASE_URL="postgresql://assetto:assetto@localhost:5432/assetto?schema=public"

# Chave usada para assinar os cookies de sessao.
# Gere uma nova com: openssl rand -base64 32
SESSION_SECRET="troque-esta-chave-em-producao-com-openssl-rand-base64-32"

# URL publica da aplicacao (usada nos links de aprovacao de orcamento)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
