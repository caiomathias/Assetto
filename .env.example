# Banco de dados PostgreSQL
# Local, com Docker (docker compose up -d):
DATABASE_URL="postgresql://assetto:assetto@localhost:5432/assetto?schema=public"

# Endereço público da aplicação. É daqui que sai o link de aprovação de
# orçamento enviado ao cliente, então em produção precisa ser o domínio real.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
